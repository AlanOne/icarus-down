---
import type { Video } from '../lib/content';
import { newTab } from '../lib/paths';
import LiteYouTube from './LiteYouTube.astro';

interface Props {
  /** Videos whose YouTube ID already parsed; see page-data.ts. */
  videos: (Video & { youtubeId: string })[];
}

const { videos } = Astro.props;
---

<section id="videos" class="section" aria-labelledby="videos-title">
  <h2 id="videos-title">Videos</h2>
  <ul class="videos">
    {
      videos.map((v) => (
        <li>
          <LiteYouTube id={v.youtubeId} title={v.title} />
          <p class="video-title">{v.title}</p>
        </li>
      ))
    }
  </ul>
</section>

<dialog class="video-dialog" aria-label="Video">
  <div class="video-dialog-frame"></div>
  <div class="video-dialog-bar">
    <a class="video-dialog-youtube" href="https://www.youtube.com/" {...newTab}>Watch on YouTube</a>
    <button type="button" class="btn" data-close autofocus>Close</button>
  </div>
</dialog>

<script>
  import '../scripts/video-dialog';
</script>
