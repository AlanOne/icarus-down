---
import { Image } from 'astro:assets';
import type { Member } from '../lib/content';
import { resolveMedia } from '../lib/media';

interface Props {
  shortBio: string;
  members: Member[];
}

const { shortBio, members } = Astro.props;
const paragraphs = shortBio
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<section id="about" class="section" aria-labelledby="about-title">
  <h2 id="about-title">About</h2>
  {paragraphs.length > 0 && <div class="bio">{paragraphs.map((p) => <p>{p}</p>)}</div>}
  {
    members.length > 0 && (
      <ul class="members">
        {members.map((m) => {
          const photo = m.photo ? resolveMedia(m.photo) : undefined;
          return (
            <li>
              {photo && <Image src={photo} width={320} height={320} alt="" class="member-photo" />}
              <p class="member-name">{m.name}</p>
              <p class="member-role">{m.role}</p>
            </li>
          );
        })}
      </ul>
    )
  }
</section>
