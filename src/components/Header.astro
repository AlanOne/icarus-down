---
// The logo is inlined so it takes the text colour (fill="currentColor") and stays sharp.
import logoSvg from '../assets/brand/logo.svg?raw';
import { url } from '../lib/paths';
import { SECTION_LABELS, type SectionId } from '../lib/sections';

interface Props {
  sections: SectionId[];
  bandName: string;
  /** Sit on top of the hero photo (home page). */
  overlay?: boolean;
  current?: 'press';
}

const { sections, bandName, overlay = false, current } = Astro.props;
// Decorative inside the link: the link itself carries the name.
const logo = logoSvg.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---

<header class:list={['site-header', { overlay }]}>
  <a class="home" href={url('')} aria-label={`${bandName} home`} set:html={logo} />
  <nav aria-label="Main">
    <ul>
      {
        sections.map((id) => (
          <li data-nav={id}>
            <a href={url(`#${id}`)}>{SECTION_LABELS[id]}</a>
          </li>
        ))
      }
      <li>
        <a href={url('press/')} aria-current={current === 'press' ? 'page' : undefined}>Press</a>
      </li>
    </ul>
  </nav>
</header>
