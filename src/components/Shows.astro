---
import { formatShowDate } from '../lib/dates';
import { newTab } from '../lib/paths';
import type { Show } from '../lib/shows';

interface Props {
  shows: Show[];
  today: string;
}

const { shows, today } = Astro.props;

/** Split "Sat 12 Dec 2027" into a calendar tile: "Dec 2027" / "12" / "Sat". */
function dateParts(date: string) {
  const full = formatShowDate(date, today);
  const [weekday, day, month, year] = full.split(' ');
  return { full, weekday, day, month: [month, year].filter(Boolean).join(' ') };
}
---

<section id="shows" class="section" aria-labelledby="shows-title">
  <h2 id="shows-title">Upcoming shows</h2>
  <ol class="shows">
    {
      shows.map((show) => {
        const d = dateParts(show.date);
        const where = [show.city, show.country].filter(Boolean).join(', ');
        return (
          <li data-show-date={show.date}>
            <time datetime={show.date} class="show-date">
              <span class="show-month" aria-hidden="true">{d.month}</span>
              <span class="show-day" aria-hidden="true">{d.day}</span>
              <span class="show-weekday" aria-hidden="true">{d.weekday}</span>
              <span class="sr-only">{d.full}</span>
            </time>
            <div class="show-info">
              <p class="venue">{show.venue}</p>
              <p class="where">{where}</p>
              {show.note && <p class="note">{show.note}</p>}
            </div>
            {show.ticketUrl && (
              <a class="tickets" href={show.ticketUrl} {...newTab}>
                Tickets<span class="sr-only"> for {show.venue}, {show.city}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</section>
