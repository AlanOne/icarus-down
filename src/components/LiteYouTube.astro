---
// Click-to-play YouTube: a local thumbnail and a button. Nothing loads from
// YouTube until the button is pressed, then the no-cookie player replaces it.
import { Image } from 'astro:assets';
import { embedUrl, thumbnailUrl } from '../lib/youtube';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<button type="button" class="lite-yt" data-embed={embedUrl(id)} data-title={title} aria-label={`Play video: ${title}`}>
  <Image src={thumbnailUrl(id)} inferSize alt="" widths={[480]} sizes="(min-width: 48rem) 33vw, 100vw" class="lite-yt-thumb" />
  <svg class="lite-yt-play" viewBox="0 0 68 48" width="68" height="48" aria-hidden="true" focusable="false">
    <rect width="68" height="48" rx="24" fill="currentColor" />
    <path d="M27 15v18l15-9z" fill="#0a1a33" />
  </svg>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-embed]')) {
    button.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = button.dataset.embed!;
      frame.title = button.dataset.title ?? 'YouTube video';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'lite-yt-frame';
      button.replaceWith(frame);
      frame.focus();
    });
  }
</script>
