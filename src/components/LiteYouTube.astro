---
// A video thumbnail that is a plain link to the video on YouTube (new tab). With
// JavaScript, src/scripts/video-dialog.ts opens it in the pop-up player instead.
// Nothing loads from YouTube until it is clicked: the thumbnail is downloaded at build time.
import { Image } from 'astro:assets';
import { newTab } from '../lib/paths';
import { embedUrl, thumbnailUrl, watchUrl } from '../lib/youtube';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<a class="lite-yt" href={watchUrl(id)} {...newTab} data-embed={embedUrl(id)} data-title={title} aria-label={`Play video: ${title}`}>
  <Image src={thumbnailUrl(id)} inferSize alt="" widths={[480]} sizes="(min-width: 48rem) 33vw, 100vw" class="lite-yt-thumb" />
  <svg class="lite-yt-play" viewBox="0 0 68 48" width="68" height="48" aria-hidden="true" focusable="false">
    <rect width="68" height="48" rx="24" fill="currentColor"></rect>
    <path d="M27 15v18l15-9z" fill="#040b16"></path>
  </svg>
</a>
