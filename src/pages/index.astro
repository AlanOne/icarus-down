---
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Music from '../components/Music.astro';
import Shows from '../components/Shows.astro';
import Videos from '../components/Videos.astro';
import Base from '../layouts/Base.astro';
import { loadMembers, loadReleases, loadShows, loadVideos } from '../lib/content';
import { todayIn } from '../lib/dates';
import { sectionsToRender } from '../lib/sections';
import { upcomingShows } from '../lib/shows';
import { loadSite } from '../lib/site-schema';
import { youtubeId } from '../lib/youtube';

const site = loadSite();
const today = todayIn(new Date());

const shows = upcomingShows(await loadShows(), today);
const releases = await loadReleases();
const members = await loadMembers();

// A video whose link isn't a YouTube link is left out rather than shown broken.
const videos = (await loadVideos()).flatMap((v) => {
  const id = youtubeId(v.url);
  if (!id) {
    console.warn(`[videos] Skipping "${v.title}": not a YouTube link (${v.url})`);
    return [];
  }
  return [{ ...v, youtubeId: id }];
});

const sections = sectionsToRender({
  releases: releases.length,
  videos: videos.length,
  upcomingShows: shows.length,
  members: members.length,
  shortBio: site.band.shortBio,
});
---

<Base
  title={`${site.band.name}: music, videos and upcoming shows`}
  description={site.band.shortBio.split(/\n/)[0]}
  path=""
>
  <Header sections={sections} bandName={site.band.name} overlay />
  <main id="main">
    <Hero bandName={site.band.name} heroPhoto={site.band.heroPhoto} releases={releases} today={today} />
    {sections.includes('shows') && <Shows shows={shows} today={today} />}
    {sections.includes('music') && <Music releases={releases} today={today} />}
    {sections.includes('videos') && <Videos videos={videos} />}
    {sections.includes('about') && <About shortBio={site.band.shortBio} members={members} />}
  </main>
  <Footer site={site} />
</Base>

<script>
  // Hides past shows and switches releases on the day, without waiting for a rebuild.
  import '../scripts/live-dates';
</script>
