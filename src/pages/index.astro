---
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Music from '../components/Music.astro';
import Shows from '../components/Shows.astro';
import Videos from '../components/Videos.astro';
import Base from '../layouts/Base.astro';
import { loadPageData } from '../lib/page-data';

const { site, today, shows, releases, members, videos, sections } = await loadPageData();
// The short bio's first line, or a plain fallback so the page never has an empty description.
const description =
  site.band.shortBio.trim().split(/\n/)[0] || `${site.band.name}: music, videos and upcoming shows.`;
---

<Base
  title={`${site.band.name}: music, videos and upcoming shows`}
  description={description}
  path=""
>
  <Header sections={sections} bandName={site.band.name} overlay />
  <main id="main">
    <Hero
      bandName={site.band.name}
      heroPhoto={site.band.heroPhoto}
      morePhotos={site.press.photos.map((p) => p.image)}
      releases={releases}
      today={today}
    />
    {sections.includes('shows') && <Shows shows={shows} today={today} />}
    {sections.includes('music') && <Music releases={releases} today={today} />}
    {sections.includes('videos') && <Videos videos={videos} />}
    {sections.includes('about') && <About shortBio={site.band.shortBio} members={members} />}
  </main>
  <Footer site={site} />
</Base>

<script>
  // Hides past shows and switches releases on the day, without waiting for a rebuild.
  import '../scripts/live-dates';
  import '../scripts/hero-slideshow';
</script>
