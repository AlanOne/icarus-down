---
import { Image } from 'astro:assets';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Shows from '../components/Shows.astro';
import Base from '../layouts/Base.astro';
import { loadMembers, loadReleases, loadShows, loadVideos } from '../lib/content';
import { todayIn } from '../lib/dates';
import { resolveMedia } from '../lib/media';
import { sectionsToRender } from '../lib/sections';
import { upcomingShows } from '../lib/shows';
import { loadSite } from '../lib/site-schema';

const site = loadSite();
const today = todayIn(new Date());

const shows = upcomingShows(await loadShows(), today);
const releases = await loadReleases();
const videos = await loadVideos();
const members = await loadMembers();

const sections = sectionsToRender({
  releases: releases.length,
  videos: videos.length,
  upcomingShows: shows.length,
  members: members.length,
  shortBio: site.band.shortBio,
});
const heroPhoto = resolveMedia(site.band.heroPhoto);
---

<Base
  title={`${site.band.name}: music, videos and upcoming shows`}
  description={site.band.shortBio.split(/\n/)[0]}
  path=""
>
  {/* Music and Videos join the nav in Task 8, when their sections exist. */}
  <Header sections={sections.filter((s) => s === 'shows' || s === 'about')} bandName={site.band.name} overlay />
  <main id="main">
    <div class="hero">
      {heroPhoto && <Image src={heroPhoto} alt="" class="hero-photo" widths={[640, 1024, 1600, 2048]} sizes="100vw" loading="eager" fetchpriority="high" />}
      <div class="hero-copy">
        <h1>{site.band.name}</h1>
      </div>
    </div>
    {sections.includes('shows') && <Shows shows={shows} today={today} />}
    {sections.includes('about') && <About shortBio={site.band.shortBio} members={members} />}
  </main>
  <Footer site={site} />
</Base>
